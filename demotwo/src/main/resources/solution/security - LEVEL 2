package com.examly.springapp.controller;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api")
public class TestController {

    @GetMapping("/public")
    public String getMessage(){
        return "This is a public method";
    }
    @GetMapping("/protected")
    public String getMessageProtected(){
        return "This is a private authenticated method";
    }
    @GetMapping("/admin")
    public String getadminProtected(){
        return "This is a admin authenticated method";
    }
    @GetMapping("/user")
    public String getUserProtected(){
        return "This is a user authenticated method";
    }


}
