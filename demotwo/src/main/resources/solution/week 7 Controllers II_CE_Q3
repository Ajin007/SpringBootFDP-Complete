package com.examly.springapp.service;

import java.util.HashMap;
import java.util.Map;
import java.util.concurrent.atomic.AtomicInteger;

import org.springframework.stereotype.Service;

import com.examly.springapp.model.Ticket;

@Service
public class TicketService {

    Map<Integer,Ticket> tickets=new HashMap<>();
    AtomicInteger ticketId=new AtomicInteger();

    public Ticket createTicket(Ticket ticket){
        return tickets.put(ticketId.getAndIncrement(), ticket);
    }

    // this method id for the updateTicke
    // PUT ----> update based on the path varaible, if you miss any body data "Ticket", that will be 
    // replaced by null
    // the entire body data shifted
    public Ticket updateTicket(int id,Ticket ticket){
        if(!tickets.containsKey(id)){

            return null;
        }
        ticket.setEventId(id);
        tickets.put(id, ticket);
        return ticket;

    }


    // this method for the patch operartion
    //  need to set the data manually
    public Ticket patchTicket(int id,Ticket ticket){

      Ticket existingTicket=  tickets.get(id);

      if(existingTicket== null){
        return null;
      }

      if(ticket.getAttendeeName()!=null){
        existingTicket.setAttendeeName(ticket.getAttendeeName());
      }

      if(ticket.getTicketPrice() != 0.0){
        existingTicket.setTicketPrice(ticket.getTicketPrice());
      }
      if(ticket.getTicketType() != null){
        existingTicket.setTicketType(ticket.getTicketType());
      }


      return existingTicket;


    }



}


